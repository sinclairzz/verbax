# DEVELOPMENT ONLY. Copy to .env or run scripts/bootstrap.py.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://verba:verba-local-only@127.0.0.1:55432/verba
# Supabase: use the Session pooler URI from Connect (port 5432).
# postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@HOST_FROM_CONNECT:5432/postgres?sslmode=require
# Backend automatically selects psycopg and requires TLS for Supabase.
# Optional: direct/session URI for Alembic when runtime uses transaction pooler (6543).
DATABASE_MIGRATION_URL=
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENCRYPTION_KEY=GENERATE_FERNET_KEY
LOOKUP_SECRET=GENERATE_RANDOM_SECRET
# Google OAuth via Supabase Auth. The publishable key is safe for browser use;
# never put the Google client secret or a Supabase service-role key here.
SUPABASE_URL=https://bdxzutoactspsobwyupc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://bdxzutoactspsobwyupc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stripe test account keys required for BOTH sandbox checkouts. Never NEXT_PUBLIC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true only after account activation, legal review and intentional live rollout.
# Production key goes ONLY in STRIPE_SECRET_KEY; replace webhook secret too.
PAYMENTS_LIVE_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=
# Required before production. Do not invent company identity or contact details.
OPERATOR_NAME=
OPERATOR_DOCUMENT=
LEGAL_REVIEW_APPROVED=false
